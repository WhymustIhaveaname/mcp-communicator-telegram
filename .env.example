# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=your_bot_token_here

# Telegram Chat ID (the chat where messages will be sent)
CHAT_ID=your_chat_id_here

# Maximum unanswered petition_majesty calls per session.
# Omit this variable or use "infinity" for no limit.
MAX_PENDING_ASK_USER_PER_SESSION=infinity

# Backstop TTL for a single pending petition_majesty, in milliseconds.
# A slot is normally returned as soon as the reply arrives, the MCP client
# disconnects, or the client sends notifications/cancelled. This timeout only
# covers the case where none of those reach the daemon, so a slot can never be
# held for the daemon's whole lifetime. Omit for the 24h default; use
# "off"/"none"/"0" to disable.
ASK_USER_TIMEOUT_MS=86400000
